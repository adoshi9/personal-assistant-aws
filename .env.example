# Application Configuration
APP_NAME=personal-assistant
APP_ENV=development
LOG_LEVEL=INFO

# AWS Configuration
AWS_REGION=us-east-1
AWS_SECRETS_PREFIX=personal-assistant/

# Telegram Bot
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN_SECRET=telegram/bot-token

# AI Provider (Anthropic Claude)
ANTHROPIC_API_KEY_SECRET=anthropic/api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096

# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Approval Workflow
APPROVAL_TIMEOUT_SECONDS=300
APPROVAL_REQUIRE_CONFIRMATION=true

# Connectors (Optional)
GITHUB_TOKEN_SECRET=github/token
OPENWEATHER_API_KEY_SECRET=openweather/api-key
GOOGLE_CALENDAR_CREDENTIALS_SECRET=google/calendar-credentials

# Database (Optional - for approval history)
# DATABASE_URL=postgresql://user:pass@localhost:5432/personal_assistant

# Monitoring (Optional)
# SENTRY_DSN=https://...
# DATADOG_API_KEY=...
